<Window x:Class="GetTripSystem.Windows.ViewTripWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GetTripSystem.Windows"
        mc:Ignorable="d"
                Title="GTrip" Height="450" Width="600"
        Background="#F7F7FF"
        Icon ="\Fonts\iconc.ico" WindowStartupLocation="CenterScreen"
        >
    <Grid Margin="0,0,0,23" >
        <Grid.RowDefinitions>
            <RowDefinition Height="19*"></RowDefinition>
            <RowDefinition Height="18*"/>
            <RowDefinition Height="36*"></RowDefinition>
            <RowDefinition Height="36*"></RowDefinition>
            <RowDefinition Height="36*"></RowDefinition>
            <RowDefinition Height="36*"></RowDefinition>
            <RowDefinition Height="36*"></RowDefinition>
            <RowDefinition Height="36*"></RowDefinition>
            <RowDefinition Height="36*"></RowDefinition>
            <RowDefinition Height="36*"></RowDefinition>
            <RowDefinition Height="36*"></RowDefinition>
            <RowDefinition Height="36*"></RowDefinition>
            <RowDefinition Height="36*"></RowDefinition>


        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <Border Grid.Row="0" Grid.ColumnSpan="100" Background="#EBEBFC" />
        <Border Grid.Row="1" Grid.ColumnSpan="100" Background="#EBEBFC" />

        <TextBlock Grid.Row="0"
            Margin="20,0,0,10"
            Width="398" HorizontalAlignment="Left"
            Text="Название"
            FontSize="24"
            Style="{StaticResource BaseFont}"
            FontWeight="Bold"
            Foreground="#0F1053"
            FontStyle="Italic"
            TextWrapping="Wrap" Grid.ColumnSpan="4" Grid.RowSpan="2"
            />

        <Label Grid.Column="0" Grid.Row="1"
               Margin="20,17,0,0"
                Content="Локация:"
                FontSize="18"
                Style="{StaticResource BaseFont}"
                FontWeight="Bold"
                Foreground="Black" Grid.RowSpan="2"/>

        <TextBlock x:Name="textLocation" Grid.Column="1" Grid.Row="2"
            Text="локация"
            Margin="20,5,0,0"
            FontSize="18"
            Style="{StaticResource BaseFont}"
            FontWeight="Bold"
            Foreground="#606086"
                   
            FontStyle="Italic" Grid.ColumnSpan="3"/>

        <Label Grid.Column="0" Grid.Row="3"
               Margin="20,0,0,36"
                Content="Дата:"
                FontSize="18"
                Style="{StaticResource BaseFont}"
                FontWeight="Bold"
                Foreground="Black" Grid.RowSpan="3"/>

        <TextBlock x:Name="textDate" Grid.Column="1" Grid.Row="3"
                Text="дата"
                Margin="20,5,0,36"
                FontSize="18"
                Style="{StaticResource BaseFont}"
                FontWeight="Bold"
                Foreground="#606086"
                   
                FontStyle="Italic" Grid.RowSpan="2"/>

        <Label  Grid.Row="4"
               Margin="20,0,0,3"
                Content="Количество человек:"
                FontSize="18"
                Style="{StaticResource BaseFont}"
                FontWeight="Bold"
                Foreground="Black" Grid.ColumnSpan="2" Grid.RowSpan="2"/>

        <TextBlock x:Name="textMembsAmount" Grid.Column="2" Grid.Row="4"
                Text="3/5"
                Margin="5,3,0,36"
                FontSize="18"
                Style="{StaticResource BaseFont}"
                FontWeight="Bold"
                Foreground="#606086"
           
                FontStyle="Italic" Grid.RowSpan="2"/>

        <Label  Grid.Row="5"
               Margin="20,0,105,1"
                Content="Контакт организатора:"
                FontSize="18"
                Style="{StaticResource BaseFont}"
                FontWeight="Bold"
                Foreground="Black" Grid.ColumnSpan="3"/>

        <TextBlock x:Name="textContact" Grid.Column="2" Grid.Row="5"
                    Text="https://github.com/k0dasha/GetTripSystem"
                    Margin="5,5,10,1"
                    FontSize="18"
                    Style="{StaticResource BaseFont}"
                    FontWeight="Bold"
                    Foreground="#606086"
   
                    FontStyle="Italic" Grid.ColumnSpan="3"/>


        <TextBox x:Name="textBox_Description" Grid.Column="0" Grid.Row="6"
                Template="{DynamicResource TextBoxTemplate4}"
                Margin="20,36,23,18"
                FontSize="20"
                Style="{StaticResource BaseFont}"
                FontWeight="Bold"
                Foreground="#1A1A1A"
                MaxLength="150"
                 Padding="10,10"
                TextWrapping="Wrap"
                Background="#EBEBFC"
                Text=" Примечания:" Grid.ColumnSpan="5" Grid.RowSpan="6" IsEnabled="False"/>

        <Button Grid.Column="1" Grid.Row="12"
            x:Name="CreateTrip" Template="{DynamicResource ButtonTemplate1}"
        Background="#0F1053"
        Content="Записаться"
        Foreground="White"
        Style="{StaticResource BaseFont}"
        FontWeight="SemiBold"
                Click="Button_AddMember_Click"
        FontSize="24" Margin="60,0,58,-1" Grid.ColumnSpan="3"
        />
    </Grid>

</Window>
