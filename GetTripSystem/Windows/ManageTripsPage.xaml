<Page x:Class="GetTripSystem.Windows.ManageTripsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:GetTripSystem.Windows"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="700"
      Title="ManageTripsWindow"
      FontFamily="C:\Users\Даша\source\repos\GetTripSystem\GetTripSystem\Fonts\Raleway-VariableFont_wght.ttf"
      Background="#EBEBFC" >

    <StackPanel>
            <Label
            Content ="Управление походами"
            FontSize="24"
            Style="{StaticResource BaseFont}"
            FontWeight="Bold"
            Foreground="#0F1053"
            Margin="20,10"
            />
        <ListView x:Name="UserTripsListView" ItemsSource="{Binding UserTripsList}" Foreground="#FF141212"
          Height="299">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Название" DisplayMemberBinding="{Binding TripName}" Width="250"/>
                    <GridViewColumn Header="Дата" DisplayMemberBinding="{Binding Date, StringFormat=dd.MM.yyyy}" Width="100"/>
                    <GridViewColumn Header="Локация" DisplayMemberBinding="{Binding Location}" Width="225"/>
                    <GridViewColumn Header="Кол-во человек" Width="100">
                        <GridViewColumn.DisplayMemberBinding>
                            <MultiBinding StringFormat="{}{0} / {1}">
                                <Binding Path="CurMembs_amount"/>
                                <Binding Path="MaxMembs_amount"/>
                            </MultiBinding>
                        </GridViewColumn.DisplayMemberBinding>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>

        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Center">
      
            <Button x:Name="EditTrip" Template="{DynamicResource ButtonTemplate1}"
               Background="#0F1053"
               IsEnabled="False"
               Content="Редактировать"
               Foreground="White"
               Style="{StaticResource BaseFont}"
               FontWeight="SemiBold"
               FontSize="15"
               Width="200" Height="30" Margin="25,10,10,5"
                />
            <Button x:Name="DeleteTrip" Template="{DynamicResource ButtonTemplate1}"
                   Background="#0F1053"
                   Content="Удалить поход"
                   IsEnabled="False"
                   Foreground="White"
                   Style="{StaticResource BaseFont}"
                   FontWeight="SemiBold"
                   FontSize="15"
                   Width="200" Height="30" Margin="0,10,25,5"
                     /> 

        </StackPanel>
        <StackPanel Orientation="Horizontal"
            HorizontalAlignment="Center">
         
            <Button x:Name="CreateTrip" Template="{DynamicResource ButtonTemplate1}"
                    Background="#0F1053"
                    Content="Создать поход"
                    Foreground="White"
                    Style="{StaticResource BaseFont}"
                    FontWeight="SemiBold"
                    FontSize="15" Click="Button_AddTrip_Click" 
                    Width="200" Height="30" Margin="25,5,10,0"
                    />
            <Button x:Name="ToMenu" Template="{DynamicResource ButtonTemplate1}"
                Background="#0F1053"
                Content="В главное меню"
                Foreground="White"
                Style="{StaticResource BaseFont}"
                FontWeight="SemiBold"
                FontSize="15" Click="Button_Back_Click" 
                Width="200" Height="30" Margin="0,5,25,0"
                />  

        </StackPanel>
    </StackPanel>
</Page>
