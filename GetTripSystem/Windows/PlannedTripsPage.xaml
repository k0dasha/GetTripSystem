<Page x:Class="GetTripSystem.Windows.PlannedTripsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:GetTripSystem.Windows"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="700"
      Title="PlannedTripsWindow"
      Background="#EBEBFC">

    <StackPanel>
        <Label
        Content ="Планируемые походы"
        FontSize="24"
        Style="{StaticResource BaseFont}"
        FontWeight="Bold"
        Foreground="#0F1053"
        Margin="20,10"
        />
        <ListView x:Name="RegsListView" ItemsSource="{Binding RegsTripsList}" Foreground="#FF141212"
                  SelectionMode="Single" Height="335">
        <ListView.View>
            <GridView>
                <GridViewColumn Header="Название" DisplayMemberBinding="{Binding TripName}" Width="250"/>
                <GridViewColumn Header="Дата" DisplayMemberBinding="{Binding Date, StringFormat=dd.MM.yyyy}" Width="100"/>
                <GridViewColumn Header="Локация" DisplayMemberBinding="{Binding Location}" Width="225"/>
                <GridViewColumn Header="Кол-во человек" Width="100">
                    <GridViewColumn.DisplayMemberBinding>
                        <MultiBinding StringFormat="{}{0} / {1}">
                            <Binding Path="CurMembs_amount"/>
                            <Binding Path="MaxMembs_amount"/>
                        </MultiBinding>
                    </GridViewColumn.DisplayMemberBinding>
                </GridViewColumn>
            </GridView>
        </ListView.View>
        </ListView>

        <StackPanel Orientation="Horizontal"
                HorizontalAlignment="Center" VerticalAlignment="Bottom">

            <Button x:Name="CancelTrip" Template="{DynamicResource ButtonTemplate1}"
           Background="#0F1053"
           Content="Отменить запись"
           Foreground="White"
           Style="{StaticResource BaseFont}"
           FontWeight="SemiBold"
           FontSize="15" Click="Button_CancelTrip_Click" 
           Width="200" Height="30" Margin="10"
             />
            
            <Button x:Name="ToMenu" Template="{DynamicResource ButtonTemplate1}"
            Background="#0F1053"
            Content="В главное меню "
            Foreground="White"
            Style="{StaticResource BaseFont}"
            FontWeight="SemiBold"
            FontSize="15" Click="Button_Back_Click" 
            Width="200" Height="30" Margin="10"
            />
        </StackPanel>

    </StackPanel>
</Page>
