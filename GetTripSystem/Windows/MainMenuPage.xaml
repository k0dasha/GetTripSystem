<Page x:Class="GetTripSystem.Windows.MainMenuPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:GetTripSystem.Windows"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="700"
      Title=""
      FontFamily="\Fonts\Raleway-VariableFont_wght.ttf" 
      Background="#EBEBFC">

    <StackPanel>
        <Label
        Content ="Главное меню"
        FontSize="24"
        Style="{StaticResource BaseFont}"
        FontWeight="Bold"
        Foreground="#0F1053"
        Margin="20,10"
    />

        <StackPanel
        Orientation="Horizontal">

            <Button x:Name="PlannedTrips" Template="{DynamicResource ButtonTemplate1}"
            Background="#0F1053"
            Margin="20,0"
            Content="Планируемые походы"
            Foreground="White"
            Style="{StaticResource BaseFont}"
            FontWeight="SemiBold"
            FontSize="15" Click="Button_Plan_Click" 
            Width="200" Height="30" HorizontalAlignment="Left" VerticalAlignment="Top"></Button>

            <Button x:Name="ManageTrips" Template="{DynamicResource ButtonTemplate1}"
            Background="#0F1053"
            Content="Управление походами"
            Foreground="White"
            Style="{StaticResource BaseFont}"
            FontWeight="SemiBold"
            FontSize="15" Click="Button_Manage_Click" 
            Width="200" Height="30" 
                
     />
        </StackPanel>

        <StackPanel Orientation="Horizontal">
            <Label
        Content ="Отфильтровать по"
        FontSize="15"
        Style="{StaticResource BaseFont}"
        FontWeight="SemiBold"
        FontStyle="Italic"
        Foreground="#9F9FBB"
        Margin="20,10"
    />
            <ComboBox x:Name="comboBox_selectSorting" Style="{DynamicResource ComboBoxStyle2}" 
            Width="115" Height="23" Background="White" SelectionChanged="ComboBox_SelectionChanged">
                <ComboBoxItem Content="Дата" Foreground="Black" Style="{StaticResource BaseFont}"/>
                <ComboBoxItem Content="Локация" Foreground="Black" Style="{StaticResource BaseFont}"/>
            </ComboBox>

        </StackPanel>
        <ListView x:Name="TripListView" ItemsSource="{Binding TripList}" Foreground="#FF141212"
                  MouseDoubleClick="TripListView_MouseDoubleClick" SelectionMode="Single">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Название" DisplayMemberBinding="{Binding TripName}" Width="250"/>
                    <GridViewColumn Header="Дата" DisplayMemberBinding="{Binding Date, StringFormat=dd.MM.yyyy}" Width="100"/>
                    <GridViewColumn Header="Локация" DisplayMemberBinding="{Binding Location}" Width="225"/>
                    <GridViewColumn Header="Кол-во человек" Width="100">
                        <GridViewColumn.DisplayMemberBinding>
                            <MultiBinding StringFormat="{}{0} / {1}">
                                <Binding Path="CurMembs_amount"/>
                                <Binding Path="MaxMembs_amount"/>
                            </MultiBinding>
                        </GridViewColumn.DisplayMemberBinding>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>



    </StackPanel>
</Page>
