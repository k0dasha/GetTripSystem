<Window x:Class="GetTripSystem.Windows.KickMembersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GetTripSystem.Windows"
        mc:Ignorable="d"
        Title="GTrip" Height="400" Width="400"
        Icon ="\Fonts\iconc.ico" WindowStartupLocation="CenterScreen"
        FontFamily="\Fonts\Raleway-VariableFont_wght.ttf"
        >
    
    <StackPanel Margin="20,10">
        <TextBlock Text="Участники похода" 
                   FontSize="24" 
                   FontWeight="Bold"
                   Foreground="#0F1053"
                   Margin="0,0,0,10"
                   Style="{StaticResource BaseFont}"/>

        <ScrollViewer Height="240">
            <WrapPanel x:Name="CardsPanel"
                       HorizontalAlignment="Center"/>
        </ScrollViewer>
        <Button x:Name="Back" Template="{DynamicResource ButtonTemplate1}"
        Background="#0F1053"
        Content="Назад"
        Foreground="White"
        Style="{StaticResource BaseFont}"
        FontWeight="SemiBold"
        FontSize="15" Click="Button_Back_Click" 
        Width="200" Height="30" Margin="25,5,10,0"
        />
    </StackPanel>

</Window>
